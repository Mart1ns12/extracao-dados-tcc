# User-agent honesto: identifica a pesquisa academica e da um canal de contato.
USER_AGENT="TCC-Scraper/1.0 (pesquisa academica; +mailto:seu-email@exemplo.com)"

# Segundos entre requisicoes ao Google News. 5,0 desde 2026-10-28: com 2,0 o IP do executor levou
# HTTP 503 apos ~180 consultas e o bloqueio durou 40 min ou mais. Nao reduzir sem medir bloqueios.
THROTTLE_GOOGLE_NEWS=5.0
# Acrescimo aleatorio (uniforme, de 0 a este valor) somado a cada espera do Google News. Evita um ritmo
# regular, que o Google reconhece. 0 desliga.
THROTTLE_GOOGLE_NEWS_JITTER_S=2.0
# Idiomas do Google News: pt, en ou pt,en. en-US era 50% das consultas e 12% das noticias.
GOOGLE_NEWS_IDIOMAS=pt
THROTTLE_YAHOO=1.0
THROTTLE_BCB=0.5
THROTTLE_ARTICLE_FETCH=1.5

# Rede dos coletores: timeout por requisicao, tentativas em falha transitoria (rede, 429, 5xx),
# teto de cada espera entre tentativas e unidades seguidas com falha do Google News (sinal de bloqueio).
HTTP_TIMEOUT_S=30
HTTP_MAX_TENTATIVAS=4
HTTP_ESPERA_MAX_S=120
# Ao atingir o limite acima, o Google News pausa (em minutos, nesta ordem) em vez de abortar.
# Sem sucesso entre as pausas, apos a ultima, aborta. Medido em 2026-10-28: o bloqueio durou 40 min ou mais.
GOOGLE_NEWS_MAX_FALHAS_SEGUIDAS=10
GOOGLE_NEWS_PAUSAS_MIN=30,60,120

# Segundos entre requisicoes a API WordPress (InfoMoney, Money Times, Exame). 1,0 s foi medido
# sem erro em 216 requisicoes em 2026-10-27. Nao reduzir sem medir bloqueios.
THROTTLE_WORDPRESS=1.0
# Coleta WordPress (InfoMoney, Money Times, Exame). false devolve esses veiculos ao Google News.
WP_ENABLED=true

# Janela do DATASET e da coleta de noticias (5 anos, decisao de 2026-10-23). Os precos sao buscados
# PRICE_WARMUP_DAYS antes de DATA_START para aquecer as janelas de 20 pregoes.
DATA_START=2021-02-01
DATA_END=2026-09-01

# Dias corridos de aquecimento dos precos antes de DATA_START (1 ano de pregoes).
PRICE_WARMUP_DAYS=400

# Cache dos modelos FinBERT (padrao: .hf_cache na raiz do projeto). Descomente para mudar o local.
# HF_CACHE_DIR=/caminho/com/espaco/hf-cache
# SENTIMENT_DEVICE=auto        # auto | cuda | cpu (auto usa GPU se houver)
# SENTIMENT_BATCH_SIZE=32      # com GPU, 128 costuma caber em 6 GB de VRAM

# Banco: unico banco do projeto (MySQL 8); nao ha banco local. O charset utf8mb4 e
# montado pelo codigo; sem ele, acentos e emoji em manchetes quebram.
IP_BANCO=
USER_BANCO=
SENHA_BANCO=
PORTA_BANCO=3306
NOME_BANCO=tcc_scraper

# Enriquecimento (extracao do corpo dos artigos).
#
# THROTTLE_LINK_RESOLVE espaca as 2 chamadas ao news.google.com por artigo e e o
# GARGALO dominante desta etapa. Medido em 2026-09-21 com artigos reais:
#   0.40 s (padrao) -> 0.94 s/artigo -> ~2.9 h para 11 mil artigos
#   0.05 s          -> 0.38 s/artigo -> ~1.1 h   (24/24 de sucesso na amostra)
# O padrao e conservador de proposito: um bloqueio no meio de uma execucao de
# horas custa mais do que as 2 h economizadas. Baixe por sua conta e risco.
THROTTLE_LINK_RESOLVE=0.4

# Workers paralelos. O ganho vem de baixar de veiculos diferentes ao mesmo tempo
# (a fila e ordenada alternando dominios). Acima de ~8 nao adianta: o resolve,
# que serializa no Google, vira o limite.
ENRICH_WORKERS=6

# Analise diaria por LLM (comando analyze-llm; no Railway roda como etapa `analise` do daily do executor).
# Dependencias pagas do projeto: Gemini (analise diaria), Claude claude-haiku-5-5 (fallback padrao
# da juiza, pago pelo credito de US$ 100/mes da Anthropic; alternativas: OpenAI gpt-5.6-luna e
# Gemini) e Jev. Teto da analise US$ 5/mes; juiza US$ 3/mes; verba do backlog US$ 15.
# Detalhes e custo: docs/04-juiza-e-llm.md (secao 3). Instale o extra: pip install -e ".[llm]"
# Agendamento: o executor dispara o daily as DAILY_HORA (padrao 08:00, America/Sao_Paulo); nao ha mais cron no Railway.
# So Gemini 3+ aceita google_search + JSON schema na mesma chamada. Alternativas:
#   gemini-3.1-flash-lite -> mais barato;  gemini-4-argon -> mais caro
# Etapa `analise` do daily. Desligada ate a analise migrar do Gemini (sem credito) para a OpenAI.
# Com false, o daily marca a etapa como pulada; o comando analyze-llm continua rodando a mao.
ANALISE_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
LLM_TIMEOUT_S=180
LLM_MAX_ATTEMPTS=3
LLM_TZ=America/Sao_Paulo

# Coleta diaria (executor). Fim da coleta: vazio/ausente = hoje.
# DATA_FIM_COLETA=2026-09-01   # vazio/ausente = hoje
# URL do painel que recebe o status do executor (vazio = sem painel).
PAINEL_API_URL=
# Token do executor para autenticar no painel.
EXECUTOR_TOKEN=
# Segundos entre consultas ao painel por tarefas pendentes.
EXECUTOR_POLL_S=5
# Segundos entre batimentos (heartbeat) enviados ao painel.
EXECUTOR_HEARTBEAT_S=15
# Nome deste executor no painel (vazio = nome da maquina).
EXECUTOR_HOST=
# Horario-alvo da coleta diaria (HH:MM, no fuso DAILY_TZ).
DAILY_HORA=08:00
# Fuso de referencia da coleta diaria.
DAILY_TZ=America/Sao_Paulo
# Orcamento da coleta diaria, em minutos.
DAILY_ORCAMENTO_MIN=90
# Hora limite (no fuso DAILY_TZ) para publicar o dia.
DAILY_PRAZO_HORA=20
# Segundos entre requisicoes a CVM (throttle por dominio).
THROTTLE_CVM=1.0
# Segundos entre requisicoes a B3 (throttle por dominio).
THROTTLE_B3=1.0
# Provedor da juiza de noticias: anthropic (padrao, fallback), openai ou gemini.
JUIZA_PROVEDOR=anthropic
# Override opcional do modelo da juiza. Vazio = padrao do provedor (anthropic: claude-haiku-5-5;
# openai: gpt-5.6-luna; gemini: gemini-3.1-flash-lite). Modelo de outro provedor = erro.
# JUIZA_MODELO=
# Teto de itens julgados pela juiza por dia.
JUIZA_MAX_ITENS_DIA=2000
# Itens por lote enviado a juiza.
JUIZA_LOTE=50
# Confianca minima (0 a 1) para aceitar o julgamento do Jev com JUIZA_JEV_MODO=decide.
# O Gemini nao e filtrado por confianca.
JUIZA_CONFIANCA_MINIMA=0.5
# Tentativas por par antes de desistir (a juiza julga 100% dos pares).
JUIZA_MAX_TENTATIVAS=3
# Pares lidos do banco por pagina, em cada ciclo da juiza.
JUIZA_PAGINA=5000
# Overrides opcionais dos precos da juiza, em US$ por milhao de tokens. Vazio = tabela do
# provedor (anthropic 0.10/0.01/0.50 entrada/cache/saida; openai 0.20/0.02/1.20;
# gemini 0.25/0.25/1.50).
# JUIZA_PRECO_ENTRADA_USD_MTOK=
# JUIZA_PRECO_CACHE_USD_MTOK=
# JUIZA_PRECO_SAIDA_USD_MTOK=
# Teto mensal, em US$, da juiza de producao (soma das runs do mes).
JUIZA_ORCAMENTO_MENSAL_USD=3.0
# Verba, em US$, do backlog da juiza (soma das runs de finalidade backlog).
JUIZA_BACKLOG_VERBA_USD=15.0
# Modo do Jev na juiza: triagem, decide ou entrega (padrao).
JUIZA_JEV_MODO=entrega
# Confianca minima do Jev no modo entrega.
JUIZA_JEV_LIMIAR_ENTREGA=0.9
# OBSOLETO: so vale se JUIZA_JEV_MODO nao estiver definido (true -> decide). Use JUIZA_JEV_MODO.
JUIZA_JEV_DECIDE=false
# Confianca minima do Jev (0 a 1) para aceitar um descarte na pre-triagem.
JUIZA_CONFIANCA_TRIAGEM=0.9
# Liga a fonte JEV.
JEV_ENABLED=true
# Chave da API JEV.
JEV_API_KEY=
# Modelo JEV.
JEV_MODELO=jev-1.13.0
# Preco do Jev, em US$ por milhao de tokens de entrada.
JEV_PRECO_ENTRADA_USD_MTOK=0.042
# Pares enviados ao Jev por lote.
JEV_LOTE=50
# Chamadas simultaneas ao Jev.
JEV_CONCORRENCIA=8
# Timeout, em segundos, de cada chamada ao Jev.
JEV_TIMEOUT_S=30.0
# Caracteres do corpo do artigo enviados ao Jev.
JEV_TRECHO=1500
# Chave da API da Anthropic (LLM de fallback padrao da juiza, claude-haiku-5-5). Segredo: so no .env.
ANTHROPIC_API_KEY=
# Timeout, em segundos, de cada chamada a Anthropic.
ANTHROPIC_TIMEOUT_S=120
# Tentativas por chamada a Anthropic (o SDK repete 408/409/429/5xx e falha de conexao).
ANTHROPIC_MAX_ATTEMPTS=3
# Esforco do modelo Anthropic na juiza (low, medium, high, xhigh ou max).
ANTHROPIC_EFFORT=medium
# Limite de tokens de saida por chamada a Anthropic.
ANTHROPIC_MAX_OUTPUT_TOKENS=16000
# Alternativa da juiza (JUIZA_PROVEDOR=openai): chave da API OpenAI. Segredo: so no .env.
OPENAI_API_KEY=
# Base da API OpenAI.
OPENAI_BASE_URL=https://api.openai.com/v1
# Timeout, em segundos, de cada chamada a OpenAI.
OPENAI_TIMEOUT_S=120
# Tentativas por chamada a OpenAI.
OPENAI_MAX_ATTEMPTS=3
# Esforco de raciocinio do modelo OpenAI (none na juiza).
OPENAI_REASONING_EFFORT=none
# Limite de tokens de saida por chamada a OpenAI.
OPENAI_MAX_OUTPUT_TOKENS=16000
# Aplica o filtro da juiza na entrega.
ENTREGA_FILTRO_JUIZA=false
# Dias de retencao dos logs do executor no painel.
PAINEL_LOGS_DIAS=7
# Pasta do Parquet e dos CSVs (padrao exports/; efemera no Railway).
# EXPORT_DIR=exports

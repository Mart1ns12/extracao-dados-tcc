# O projeto roda em PostgreSQL ou MySQL 8 -- o codigo e portavel e o dataset sai
# identico nos dois (verificado por teste de paridade). Escolha UMA:
#
# PostgreSQL local (desenvolvimento; porta 5433 evita conflito com outra instalacao):
DATABASE_URL=postgresql+psycopg://tcc:tcc_local_dev@localhost:5433/tcc_scraper
#
# MySQL 8 (servidor). Instale o driver: pip install -e ".[mysql]"
# O charset utf8mb4 nao e opcional: sem ele, acentos e emoji em manchetes quebram.
# DATABASE_URL=mysql+pymysql://usuario:senha@127.0.0.1:3306/tcc_scraper?charset=utf8mb4

# User-agent honesto: identifica a pesquisa academica e da um canal de contato.
USER_AGENT="TCC-Scraper/1.0 (pesquisa academica; +mailto:seu-email@exemplo.com)"

# Segundos entre requisicoes ao mesmo dominio. Nao reduzir sem medir bloqueios.
THROTTLE_GOOGLE_NEWS=2.0
THROTTLE_YAHOO=1.0
THROTTLE_BCB=0.5
THROTTLE_ARTICLE_FETCH=1.5

# Janela historica do dataset.
DATA_START=2024-09-01
DATA_END=2026-09-01

# Token opcional da Brapi (fallback de preco). Funciona sem token, com limite menor.
BRAPI_TOKEN=
